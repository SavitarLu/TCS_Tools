# 复制为 db.properties 后填写真实值（db.properties 已被 .gitignore 忽略，不会提交）
# 也可以改用环境变量 DB_URL / DB_USER / DB_PASSWORD / DB_DRIVER，
# 优先级：环境变量 > 系统属性 > 工作目录 db.properties > classpath db.properties
db.driver=com.ibm.db2.jcc.DB2Driver
db.url=jdbc:db2://<host>:<port>/<database>
db.user=<user>
db.password=<password>
